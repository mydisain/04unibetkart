# Example: mongodb+srv://kartuser:securePassword123@cluster0.ab123.mongodb.net/kartbookingdb?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://UniMELKeskus2025:NTrbr6I8RiK6lVO1@cluster0.ubppoud.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0

# Security Configuration
# Generate a secure random string (at least 32 characters recommended)
JWT_SECRET=unibet-kart-booking-secret-2025
JWT_EXPIRE=30d

# Email Configuration (if your app uses email notifications)
EMAIL_SERVICE=gmail
EMAIL_USERNAME=your.email@gmail.com
EMAIL_PASSWORD=your_app_password
